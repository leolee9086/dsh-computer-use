{
  "name": "dsh-computer-use",
  "version": "0.5.2",
  "private": true,
  "description": "Independent visual, accessibility and Windows Narrator computer-use plugins for DeepSeek Harness",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/leolee9086/dsh-computer-use.git" },
  "homepage": "https://github.com/leolee9086/dsh-computer-use#readme",
  "bugs": { "url": "https://github.com/leolee9086/dsh-computer-use/issues" },
  "keywords": ["deepseek-harness", "cordis", "computer-use", "desktop-automation", "screenshot", "accessibility", "ui-automation", "msaa", "narrator"],
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./host": "./src/host.js",
    "./tool": "./src/tool.js",
    "./prompt": "./src/prompt.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "scripts", "native/release", "native/src", "native/Cargo.toml", "native/Cargo.lock", "native/README.md", "cordis.patch.yml", "README.md", "CHANGELOG.md", "SECURITY.md", "EVIDENCE.md", "LICENSE", "references"],
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "dsh": {
    "client": { "inject": [], "platform": "web" },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.js",
    "smoke:windows": "node test/win32-csharp-smoke.mjs && node test/win32-smoke.mjs && node test/win32-semantic-focus-smoke.mjs && node test/win32-expansion-smoke.mjs && node test/win32-msaa-smoke.mjs && node test/win32-native-expansion-smoke.mjs",
    "smoke:semantics": "node test/win32-semantic-large-tree-smoke.mjs",
    "smoke:electron": "node scripts/smoke-electron.mjs",
    "smoke:linux": "node test/linux-smoke.mjs",
    "smoke:macos": "node test/macos-smoke.mjs",
    "verify:profile": "node test/profile-runtime-probe.mjs",
    "verify": "pnpm run check && pnpm test",
    "native:stage": "node scripts/stage-native.mjs",
    "prepack": "pnpm run verify && node scripts/check-native.mjs"
  },
  "optionalDependencies": { "edge-js": "^26.1.0", "electron-edge-js": "44.0.0" }
}
